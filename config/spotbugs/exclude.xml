<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- OpenAPI Generator owns these classes; analyze the contract and handwritten delegates. -->
    <Match>
        <Package name="~com\.example\.entrasso\.generated(\..*)?"/>
    </Match>

    <!-- HttpSecurity.build() exposes Exception, so Spring @Bean configuration must propagate it. -->
    <Match>
        <Class name="com.example.entrasso.security.EntraSecurityConfiguration"/>
        <Method name="securityFilterChain"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>

    <!-- The compact record constructor replaces this map and every value with immutable copies. -->
    <Match>
        <Class name="com.example.entrasso.security.EntraSecurityProperties"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
