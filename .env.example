# Copy this file to .env. The Makefile loads .env automatically and never prints secret values.
# These three Entra identifiers are configuration rather than secrets. They are required only by
# `make entra`; leave them empty when using the isolated local JWT mode.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=

# Local ports. Change these only when the defaults conflict with another process.
BACKEND_PORT=8080
ENTRA_UI_PORT=5173
LOCAL_ISSUER_PORT=9090
LOCAL_UI_PORT=5174

# The mock issuer and production backend must use the same local audience.
LOCAL_TOKEN_AUDIENCE=local-spring-api

# Browser logging for the production React development server.
VITE_LOG_LEVEL=debug

# Optional. Request at https://nvd.nist.gov/developers/request-an-api-key.
# Never commit a real key; .env is ignored by Git.
NVD_API_KEY=
